#include <stdio.h>

int main()
{
    int n;
    int sum = 0;
    
    scanf ("%d", &n);
    
    for (int i = 1; i <= n; i++)
    {
        sum += i;
    }
    printf("The sum of the numbers is: %d", sum);
    return 0;
}
