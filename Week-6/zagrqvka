#include <stdio.h>

int absoluteValue(int number)
{
    if (number < 0)
    {
        return -number;
    }

    return number;
}

int main()
{
    int number;
    
    scanf("%d", &number);
    
    number = absoluteValue(number);
    
    printf("%d", number);
    
    return 0;
}
