//int isDigit(char symbol); //връща дали символът е цифра
#include <stdio.h>

int isDigit(char symbol)
{
    if (symbol >= '0' && symbol <= '9')
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

int main()
{
    char symbol;
  
    scanf("%c", &symbol);
  
    printf("%d", isDigit(symbol));
}
