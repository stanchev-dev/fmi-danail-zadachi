//char toUpper(char symbol); // ако буквата е малка връща съответната и главна
#include <stdio.h>

char toUpper(char symbol)
{
    if (symbol >= 'a' && symbol <= 'z')
    {
        return symbol-32;
    }
    else
    {
        return symbol;
    }
}

int main()
{
    char symbol;
  
    scanf("%c", &symbol);
  
    printf("%c", toUpper(symbol));
}
